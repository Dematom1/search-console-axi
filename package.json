{
  "name": "search-console-axi",
  "version": "0.1.3",
  "description": "Google Search Console reporting and preview-gated Indexing API CLI for agents",
  "type": "module",
  "license": "MIT",
  "repository": "git+https://github.com/Dematom1/search-console-axi.git",
  "homepage": "https://github.com/Dematom1/search-console-axi#readme",
  "bugs": {
    "url": "https://github.com/Dematom1/search-console-axi/issues"
  },
  "bin": {
    "search-console-axi": "./dist/bin/search-console-axi.js"
  },
  "files": [
    "dist/bin",
    "dist/src",
    "skills/search-console-axi",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint .",
    "format:check": "prettier --check .",
    "test": "npm run build && node --test \"test/**/*.test.js\"",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@toon-format/toon": "2.3.1",
    "axi-sdk-js": "0.1.13",
    "google-auth-library": "11.3.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "oxlint": "1.93.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
